{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["playwright*.ts", "pages/**/*.ts", "tests/**/*.ts", "fixtures/**/*.ts", "data/**/*.ts", "utils/**/*.ts"]
}
